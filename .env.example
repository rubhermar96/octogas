# Base pública de la API (usada en el navegador para acortar enlaces al compartir rutas).
# En desarrollo apunta al backend local; en producción, cámbiala a la URL pública de la API.
PUBLIC_API_BASE_URL=http://localhost:3001

# Cadena de conexión a Postgres (usada en el build para hornear los gráficos de histórico).
DATABASE_URL=postgres://octogas:octogas@localhost:5432/octogas

# Verificación de Google Search Console: pega SOLO el valor del atributo `content`
# del meta google-site-verification que te da Google (no la etiqueta entera).
# Mientras esté vacío, no se inserta la etiqueta.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ID de editor de Google AdSense (ca-pub-XXXXXXXXXXXXXXXX). Mientras esté vacío,
# no se cargan anuncios ni se reservan huecos de publicidad.
PUBLIC_ADSENSE_ID=
