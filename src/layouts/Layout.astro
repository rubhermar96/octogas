---
// Fuentes self-hosted (sin llamadas a Google Fonts -> mejor rendimiento y privacidad).
// Pesos: solo los que se usan en el CSS (el 300 no se usaba; el 800 sí, y antes
// el navegador lo sintetizaba a partir del 700 con peor resultado).
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import "@fontsource/geist-sans/800.css";
import "@fontsource/unbounded/700.css";
import "../styles/global.css";
import styles from "../styles/Layout.module.css";
import iconFontUrl from "../assets/fonts/material-symbols-outlined.woff2?url";

import { SITE, GOOGLE_SITE_VERIFICATION, ADSENSE_ID } from "../consts";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: string;
    noindex?: boolean;
    hideSidebar?: boolean;
    hideHeaderLogo?: boolean;
}

const {
    title,
    description = SITE.description,
    ogImage = SITE.ogImage,
    ogType = "website",
    noindex = false,
    hideSidebar = false,
    hideHeaderLogo = false,
} = Astro.props;

const isHome = Astro.url.pathname === "/";

// Canonical y URLs absolutas (Astro.site = dominio de astro.config).
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

// Datos estructurados globales (Organización + buscador del sitio).
const orgJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: Astro.site?.href,
    description: SITE.description,
    inLanguage: "es-ES",
    potentialAction: {
        "@type": "SearchAction",
        target: {
            "@type": "EntryPoint",
            urlTemplate: new URL("/municipios/?q={search_term_string}", Astro.site).href,
        },
        "query-input": "required name=search_term_string",
    },
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <script is:inline>
            // Antes de pintar: el tema guardado (si no, cada página se pintaba oscura y
            // cambiaba a clara un instante después) y las animaciones de entrada
            // (global.css), salvo sin IntersectionObserver o si se pide reducir el
            // movimiento. Red de seguridad: si el script que las lanza (al final del
            // body) no llegara a ejecutarse, se quitan y se ve todo.
            (function () {
                var root = document.documentElement;
                try {
                    if (localStorage.getItem("theme") === "light") root.setAttribute("data-theme", "light");
                } catch (e) {}
                if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    root.classList.add("motion");
                    setTimeout(function () {
                        if (!root.classList.contains("motion-ready")) root.classList.remove("motion");
                    }, 4000);
                }
            })();
        </script>

        {GOOGLE_SITE_VERIFICATION && (
            <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
        )}

        <!-- SEO básico -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta name="theme-color" content="#34d399" />
        <meta name="generator" content={Astro.generator} />

        <!-- Open Graph -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        {ogImage === SITE.ogImage && (
            <>
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
                <meta property="og:image:alt" content="Logotipo de OCTO" />
            </>
        )}
        <meta property="og:locale" content={SITE.locale} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Datos estructurados globales -->
        <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

        <!-- Iconos: fuente propia con solo los que usamos (global.css; con un icono
             nuevo, npm run icons). Precargada para que no tarden en aparecer. -->
        <link rel="preload" href={iconFontUrl} as="font" type="font/woff2" crossorigin />

        <slot name="head" />
    </head>
    <body class={`custom-scrollbar ${isHome ? 'home-page' : ''} ${!hideSidebar ? 'has-sidebar' : ''}`}>
        <div class="nav-progress" aria-hidden="true"></div>

        <!-- Floating Header -->
        <header class={styles.header} id="main-header">
            {!hideHeaderLogo && (
            <div class={styles.headerLeft} id="header-logo">
                <a href="/">
                    <img src="/images/logo-octo.webp" alt="OCTO" class={styles.headerLogo} width="540" height="201" />
                </a>
            </div>
            )}

            <div class={styles.headerControls}>
                <button class={styles.themeToggle} id="theme-toggle" aria-label="Cambiar entre tema claro y oscuro">
                    <span class={`material-symbols-outlined ${styles.themeToggleIcon} ${styles.sun}`} aria-hidden="true">light_mode</span>
                    <span class={`material-symbols-outlined ${styles.themeToggleIcon} ${styles.moon}`} aria-hidden="true">dark_mode</span>
                </button>

                <button class={styles.hamburger} id="menu-toggle" aria-label="Abrir menú" aria-controls="menu-overlay">
                    <div class={styles.hamburgerLine}></div>
                    <div class={styles.hamburgerLine}></div>
                    <div class={styles.hamburgerLine}></div>
                </button>
            </div>
        </header>

        <!-- Flashy Lateral Menu Overlay -->
        <nav class={styles.menuOverlay} id="menu-overlay" aria-label="Menú">
            <button class={styles.closeMenu} id="close-menu" aria-label="Cerrar menú">
                <span class={`material-symbols-outlined ${styles.closeIcon}`} aria-hidden="true">close</span>
            </button>
            <div class={styles.menuNav}>
                <a href="/" class={styles.menuLink}>Inicio</a>
                <a href="/municipios/" class={styles.menuLink}>Explorador</a>
                <a href="/rutas/" class={styles.menuLink}>Planificar viaje</a>
                <a href="/comparador/" class={styles.menuLink}>Comparador</a>
            </div>
        </nav>

        <div class={styles.shell}>
            {/* Sidebar */}
            {!hideSidebar && (
            <aside class={`${styles.sidebar} custom-scrollbar`}>
                {/* Logo Section */}
                <div class={styles.brandSection}>
                    <div class={styles.brandContainer}>
                        <div class={styles.logoBox}>
                            <img
                                src="/images/logo-octo.webp"
                                width="540"
                                height="201"
                                alt="OCTO Logo"
                                class={styles.logoImage}
                            />
                        </div>
                        <p class={styles.brandSubtitle}>
                            Menos gasto, más kilómetros
                        </p>
                    </div>
                </div>

                <!-- Navigation -->
                <nav class={styles.nav} aria-label="Navegación principal">
                    <a
                        href="/"
                        class={`${styles.navItem} ${Astro.url.pathname === "/" ? styles.active : ""}`}
                    >
                        <span
                            class={`material-symbols-outlined ${styles.navIcon}`} aria-hidden="true"
                            >home</span
                        >
                        <span class={styles.navLabel}
                            >Inicio</span
                        >
                    </a>
                    <a
                        href="/municipios/"
                        class={`${styles.navItem} ${(Astro.url.pathname === "/municipios/" || Astro.url.pathname === "/explorador/") ? styles.active : ""}`}
                    >
                        <span
                            class={`material-symbols-outlined ${styles.navIcon}`} aria-hidden="true"
                            >explore</span
                        >
                        <span class={styles.navLabel}
                            >Explorador de Precios</span
                        >
                    </a>
                    <a
                        href="/rutas/"
                        class={`${styles.navItem} ${Astro.url.pathname === "/rutas/" ? styles.active : ""}`}
                    >
                        <span
                            class={`material-symbols-outlined ${styles.navIcon}`} aria-hidden="true"
                            >route</span
                        >
                        <span class={styles.navLabel}>Planificar viaje</span>
                    </a>
                    <a
                        href="/comparador/"
                        class={`${styles.navItem} ${Astro.url.pathname === "/comparador/" ? styles.active : ""}`}
                    >
                        <span
                            class={`material-symbols-outlined ${styles.navIcon}`} aria-hidden="true"
                            >balance</span
                        >
                        <span class={styles.navLabel}>Comparador</span>
                    </a>
                </nav>
            </aside>
            )}

            <!-- Main Content -->
            <main class={styles.main}>
                <slot />
            </main>
        </div>

        {/* Sin publicidad activa no hay cookies de terceros: no procede pedir
            consentimiento. El banner vuelve solo al configurar PUBLIC_ADSENSE_ID. */}
        {ADSENSE_ID && <ConsentBanner />}

        <script is:inline>
            // Animaciones de entrada (global.css): cada bloque marcado con data-reveal,
            // data-reveal-children o data-reveal-items aparece al entrar en pantalla; los
            // que entran a la vez, escalonados. Va en línea al final del body para
            // enganchar el observador en cuanto existe el contenido.
            (function () {
                var root = document.documentElement;
                if (!root.classList.contains("motion")) return;
                var io = new IntersectionObserver(
                    function (entries) {
                        var n = 0;
                        entries.forEach(function (e) {
                            if (!e.isIntersecting) return;
                            e.target.style.setProperty("--reveal-delay", Math.min(n++, 6) * 60 + "ms");
                            e.target.classList.add("is-revealed");
                            io.unobserve(e.target);
                        });
                    },
                    { rootMargin: "0px 0px -6% 0px" }
                );
                document
                    .querySelectorAll("[data-reveal], [data-reveal-children] > *, [data-reveal-items] > *")
                    .forEach(function (el) {
                        io.observe(el);
                    });
                root.classList.add("motion-ready");
            })();
        </script>
    </body>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const bodyTag = document.body;
            const menuToggle = document.getElementById('menu-toggle');
            const themeToggle = document.getElementById('theme-toggle');
            const closeMenuBtn = document.getElementById('close-menu');
            const menuLinks = document.querySelectorAll('#menu-overlay a');
            const htmlElement = document.documentElement;

            // Hamburger Menu Toggle
            menuToggle?.addEventListener('click', () => {
                bodyTag.classList.toggle('menu-open');
            });

            // Close Menu
            closeMenuBtn?.addEventListener('click', () => {
                bodyTag.classList.remove('menu-open');
            });

            menuLinks.forEach(link => {
                link.addEventListener('click', () => {
                    bodyTag.classList.remove('menu-open');
                });
            });

            // Barra de progreso (global.css) al pulsar un enlace a otra página de la web.
            document.addEventListener('click', (e) => {
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                const link = (e.target as Element | null)?.closest('a[href]') as HTMLAnchorElement | null;
                if (!link || (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
                const url = new URL(link.href, location.href);
                if (url.origin !== location.origin) return;
                if (url.pathname === location.pathname && url.search === location.search) return; // mismo documento (#ancla)
                htmlElement.classList.add('is-navigating');
                // Por si la navegación se cancela (botón de parar del navegador).
                setTimeout(() => htmlElement.classList.remove('is-navigating'), 15000);
            });
            // Al volver con "atrás" el navegador restaura la página tal cual: sin barra.
            window.addEventListener('pageshow', () => htmlElement.classList.remove('is-navigating'));

            // Light/Dark Mode Toggle
            const initTheme = () => {
                const savedTheme = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                
                if (savedTheme === 'light') {
                    htmlElement.setAttribute('data-theme', 'light');
                    themeToggle?.classList.remove('is-dark');
                } else if (savedTheme === 'dark' || prefersDark) {
                    htmlElement.removeAttribute('data-theme');
                    themeToggle?.classList.add('is-dark');
                } else {
                    htmlElement.removeAttribute('data-theme');
                    themeToggle?.classList.add('is-dark');
                }
            };

            initTheme();

            themeToggle?.addEventListener('click', () => {
                const isDarCurrently = themeToggle.classList.contains('is-dark');
                if (isDarCurrently) {
                    htmlElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                    themeToggle.classList.remove('is-dark');
                } else {
                    htmlElement.removeAttribute('data-theme');
                    localStorage.setItem('theme', 'dark');
                    themeToggle.classList.add('is-dark');
                }
            });
        });
    </script>
</html>
