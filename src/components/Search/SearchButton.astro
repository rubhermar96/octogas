---
/** Botón de la cabecera que abre el buscador (SiteSearch.astro, que lleva el script). */
import styles from "./SiteSearch.module.css";
---

<button
    type="button"
    class={styles.trigger}
    data-search-open
    aria-haspopup="dialog"
    aria-controls="site-search"
    aria-label="Buscar municipio o gasolinera"
    title="Buscar municipio o gasolinera"
>
    <span class="material-symbols-outlined" aria-hidden="true">search</span>
    <span class={styles.triggerLabel}>Buscar</span>
    <kbd class={styles.triggerKey} aria-hidden="true">/</kbd>
</button>
