---
/**
 * Aviso para instalar OCTO como app, abajo en la pantalla (no tapa la página: Google
 * penaliza en el móvil las ventanas que cubren el contenido). Sale tras 30 segundos de
 * uso en la visita, sumando las páginas, solo a quien puede instalarla y no la tiene:
 *   - Chrome, Edge, Samsung Internet: el navegador avisa de que se puede instalar
 *     (beforeinstallprompt, que guarda el script del Layout) y no lo hace si ya está
 *     instalada; "Instalar" abre su instalación.
 *   - iPhone y iPad: no hay forma de saber si ya está ni de instalarla desde la web, así
 *     que se explican los dos pasos.
 * Nunca con la web abierta como app, ni con el aviso de cookies a la vista, ni en Mis
 * gasolineras (que ya tiene el suyo). "Ahora no" lo calla 14 días; instalada, para siempre.
 * Además, las tarjetas de los menús (InstallCard.astro: se enseñan con [data-install-show]
 * y su botón lleva [data-install-open]) instalan directamente donde se puede, o enseñan
 * este aviso con los pasos en iPhone.
 */
import styles from "./InstallPrompt.module.css";
---

<aside class={styles.banner} id="install-prompt" aria-label="Instalar OCTO" hidden>
    <div class={styles.shot} aria-hidden="true">
        <img src="/images/app/app-mapa-360.webp" alt="" width="360" height="779" loading="lazy" decoding="async" />
    </div>
    <div class={styles.text}>
        <p class={styles.kicker}>App gratis · sin registrarte</p>
        <p class={styles.title}>Lleva OCTO en el móvil</p>
        <ul class={styles.perks} data-install-text="prompt">
            <li><span class="material-symbols-outlined" aria-hidden="true">bookmarks</span>Tus gasolineras a un toque</li>
            <li><span class="material-symbols-outlined" aria-hidden="true">notifications_active</span>Avisos cuando baja el precio</li>
        </ul>
        <p class={styles.body} data-install-text="ios" hidden>
            Pulsa <span class="material-symbols-outlined" aria-hidden="true">ios_share</span><b>Compartir</b> y después
            <b>Añadir a pantalla de inicio</b>.
        </p>
        <div class={styles.actions}>
            <button type="button" class={styles.install} data-install-yes>
                <span class="material-symbols-outlined" aria-hidden="true">add_to_home_screen</span>Instalar
            </button>
            <button type="button" class={styles.later} data-install-no>Ahora no</button>
        </div>
    </div>
</aside>

<script>
    import { track } from "../lib/track";

    const DISMISSED = "octo-install-dismissed"; // fecha (ms) del último "Ahora no"
    const INSTALLED = "octo-installed";
    const ENGAGED = "octo-engaged-ms"; // tiempo de uso en esta visita (sessionStorage)
    const WAIT_MS = 30_000;
    const QUIET_MS = 14 * 86_400_000;

    const banner = document.getElementById("install-prompt");
    const get = (store: Storage, key: string) => {
        try {
            return store.getItem(key);
        } catch {
            return null;
        }
    };
    const set = (store: Storage, key: string, value: string) => {
        try {
            store.setItem(key, value);
        } catch {}
    };

    const standalone =
        matchMedia("(display-mode: standalone)").matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
    const ios = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (standalone) set(localStorage, INSTALLED, "1");

    let timer: ReturnType<typeof setInterval> | undefined;
    const hide = () => {
        if (banner) banner.hidden = true;
    };

    /** Abre la instalación del navegador (Chrome, Edge...). Devuelve si la había. */
    async function installNow(): Promise<boolean> {
        const e = window.__octoInstall;
        if (!e) return false;
        await e.prompt();
        const { outcome } = await e.userChoice;
        window.__octoInstall = null;
        if (outcome === "dismissed") set(localStorage, DISMISSED, String(Date.now()));
        hide();
        syncButtons();
        return true;
    }

    /** Enseña el aviso: con botón de instalar o, en iPhone, con los pasos. */
    function show(source: "tiempo" | "menu") {
        if (!banner) return;
        banner.querySelector<HTMLElement>('[data-install-text="prompt"]')!.hidden = !window.__octoInstall;
        banner.querySelector<HTMLElement>('[data-install-text="ios"]')!.hidden = !!window.__octoInstall;
        // En iPhone no hay botón de instalar: solo los pasos.
        banner.querySelector<HTMLElement>("[data-install-yes]")!.hidden = !window.__octoInstall;
        banner.hidden = false;
        track("ver_aviso_instalar", { tipo: window.__octoInstall ? "boton" : "ios", origen: source });
    }

    // Tarjetas de los menús (InstallCard.astro): solo donde se puede instalar y no está ya
    // instalada. Su botón instala directamente; en iPhone, enseña los pasos.
    const canInstall = () => !standalone && get(localStorage, INSTALLED) !== "1" && (!!window.__octoInstall || ios);
    function syncButtons() {
        for (const b of document.querySelectorAll<HTMLElement>("[data-install-show]")) b.hidden = !canInstall();
    }
    syncButtons();
    window.addEventListener("octo-installable", syncButtons);
    document.addEventListener("click", async (ev) => {
        const b = (ev.target as Element | null)?.closest("[data-install-open]");
        if (!b) return;
        ev.preventDefault();
        document.body.classList.remove("menu-open");
        track("pulsar_instalar_menu", { tipo: window.__octoInstall ? "boton" : "ios" });
        if (!(await installNow())) show("menu");
    });

    banner?.querySelector("[data-install-yes]")!.addEventListener("click", () => void installNow());
    banner?.querySelector("[data-install-no]")!.addEventListener("click", () => {
        set(localStorage, DISMISSED, String(Date.now()));
        track("descartar_aviso_instalar");
        hide();
    });
    window.addEventListener("appinstalled", () => {
        set(localStorage, INSTALLED, "1");
        if (timer) clearInterval(timer);
        hide();
        syncButtons();
    });

    // Aviso automático tras 30 s de uso.
    const quiet =
        !banner ||
        !canInstall() && !("onbeforeinstallprompt" in window) ||
        standalone ||
        get(localStorage, INSTALLED) === "1" ||
        Date.now() - Number(get(localStorage, DISMISSED) ?? 0) < QUIET_MS ||
        location.pathname === "/mis-gasolineras/";

    if (!quiet) {
        let engaged = Number(get(sessionStorage, ENGAGED) ?? 0);
        const cookiesOpen = () => {
            const c = document.getElementById("cookie-consent");
            return !!c && !c.hidden;
        };
        // Cuenta el tiempo con la página a la vista y suma el de las páginas anteriores.
        timer = setInterval(() => {
            if (document.visibilityState !== "visible") return;
            engaged += 1000;
            set(sessionStorage, ENGAGED, String(engaged));
            if (engaged >= WAIT_MS && canInstall() && !cookiesOpen()) {
                clearInterval(timer);
                show("tiempo");
            }
        }, 1000);
    }
</script>
