---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import MunicipalitySearch from "../components/Explorer/MunicipalitySearch";
import Footer from "../components/Footer.astro";
import { displayProvince } from "../lib/placeName";
import { provinceUrl, municipioUrl } from "../lib/stationUrl";
import type { GasStation } from "../types/gasolinera";

// Lista de provincias (con nº de gasolineras) para enlazar a sus páginas.
const stationsData = JSON.parse(
    fs.readFileSync(path.resolve("public/data/stations.json"), "utf-8")
) as GasStation[];
const provCounts = new Map<string, number>();
for (const s of stationsData) {
    if (s.province) provCounts.set(s.province, (provCounts.get(s.province) ?? 0) + 1);
}
const provinces = [...provCounts.entries()]
    .map(([name, count]) => ({ label: displayProvince(name), url: provinceUrl(name), count }))
    .sort((a, b) => a.label.localeCompare(b.label, "es"));

// Ciudades principales (nombre visible + provincia/municipio en bruto, tal
// como vienen del Ministerio, para que municipioUrl() calcule la ruta).
const mainCities: { name: string; province: string; city: string }[] = [
    { name: "Madrid", province: "MADRID", city: "Madrid" },
    { name: "Barcelona", province: "BARCELONA", city: "Barcelona" },
    { name: "Valencia", province: "VALENCIA / VALÈNCIA", city: "Valencia" },
    { name: "Sevilla", province: "SEVILLA", city: "Sevilla" },
    { name: "Zaragoza", province: "ZARAGOZA", city: "Zaragoza" },
    { name: "Málaga", province: "MÁLAGA", city: "Málaga" },
    { name: "Murcia", province: "MURCIA", city: "Murcia" },
    { name: "Palma de Mallorca", province: "BALEARS (ILLES)", city: "Palma de Mallorca" },
    { name: "Las Palmas de Gran Canaria", province: "PALMAS (LAS)", city: "Palmas de Gran Canaria (Las)" },
    { name: "Córdoba", province: "CÓRDOBA", city: "Córdoba" },
    { name: "Valladolid", province: "VALLADOLID", city: "Valladolid" },
    { name: "Alicante", province: "ALICANTE", city: "Alicante/Alacant" },
    { name: "Cartagena", province: "MURCIA", city: "Cartagena" },
    { name: "Jerez de la Frontera", province: "CÁDIZ", city: "Jerez de la Frontera" },
    { name: "Bilbao", province: "BIZKAIA", city: "Bilbao" },
    { name: "Granada", province: "GRANADA", city: "Granada" },
];
---

<Layout
    title="Buscar gasolineras por municipio en España | OCTO"
    description="Busca tu municipio y compara al instante los precios de gasolina y diésel de las gasolineras de tu zona. Datos oficiales actualizados de toda España."
    hideSidebar={true}
>
    {/* El índice de municipios del buscador se descarga en paralelo con el JS de la isla. */}
    <link rel="preload" href="/data/municipios.json" as="fetch" crossorigin="anonymous" slot="head" />
    <div class="municipios-page" data-reveal-children>
        <section class="search-container">
            <header class="page-header">
                <a href="/" class="back-link">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    Volver al inicio
                </a>
                <h1 class="title">Encuentra tu <span class="text-gradient">gasolinera</span></h1>
                <p class="subtitle">Escribe el nombre de tu pueblo o ciudad para comparar los precios exactos del combustible.</p>
            </header>

            <div class="search-box">
                <MunicipalitySearch client:only="react" />
            </div>

            <div class="location-cta">
                <span class="divider-text">o</span>
                <a href="/explorador/?mode=location" class="location-button btn-pop">
                    <span class="material-symbols-outlined" aria-hidden="true">my_location</span>
                    Usar mi ubicación en tiempo real
                </a>
            </div>

            <div class="quick-links">
                <h2>Ciudades principales</h2>
                <div class="cities-grid" data-reveal-items>
                    {
                        mainCities.map((c) => (
                            <a href={municipioUrl(c.province, c.city)} class="city-card hover-lift">
                                <span class="city-name">{c.name}</span>
                                <span class="city-icon material-symbols-outlined" aria-hidden="true">location_city</span>
                            </a>
                        ))
                    }
                </div>
            </div>

            <a href="/precios-combustible-espana/" class="espana-link hover-lift">
                <span class="material-symbols-outlined" aria-hidden="true">trending_up</span>
                <span>
                    <strong>Precio medio de la gasolina y el diésel en España</strong>
                    <small>Mira la media nacional y su evolución</small>
                </span>
                <span class="material-symbols-outlined arrow" aria-hidden="true">arrow_forward</span>
            </a>

            <div class="quick-links">
                <h2>Gasolineras por provincia</h2>
                <div class="province-grid" data-reveal-items>
                    {
                        provinces.map((p) => (
                            <a href={p.url} class="province-link hover-lift">
                                <span class="province-name">{p.label}</span>
                                <span class="province-count">{p.count}</span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </div>

    <Footer />
</Layout>

<style>
    .municipios-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 6rem 2rem 2rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .search-container {
        width: 100%;
        max-width: 1100px;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        z-index: 1;
    }

    .page-header {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
        align-self: flex-start;
        margin-bottom: 1rem;
    }

    .back-link:hover {
        color: var(--primary);
    }

    .title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        color: var(--text);
        margin: 0;
        line-height: 1.1;
    }

    .text-gradient {
        background: linear-gradient(135deg, var(--primary) 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .search-box {
        width: 100%;
        margin-top: 1rem;
    }

    .location-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .divider-text {
        color: var(--text-muted);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .location-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.5rem;
        border-radius: 0.75rem;
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }

    .location-button:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }

    .quick-links {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .quick-links h2 {
        font-size: 1.25rem;
        color: var(--text);
        font-weight: 700;
        margin: 0;
    }

    .cities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    .city-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        text-decoration: none;
        color: var(--text);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .city-card:hover {
        border-color: var(--primary);
        box-shadow: 0 10px 30px rgba(54, 211, 153, 0.15);
        transform: translateY(-4px);
    }

    .city-name {
        font-weight: 700;
        font-size: 1.1rem;
    }

    .city-icon {
        color: var(--primary);
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .city-card:hover .city-icon {
        opacity: 1;
    }

    .espana-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        background: linear-gradient(135deg, rgba(52, 211, 153, 0.12), rgba(56, 189, 248, 0.1));
        border: 1px solid rgba(52, 211, 153, 0.35);
        border-radius: 1rem;
        text-decoration: none;
        color: var(--text);
        transition: transform 0.2s, border-color 0.2s;
    }
    .espana-link:hover {
        transform: translateY(-2px);
        border-color: var(--primary);
    }
    .espana-link > .material-symbols-outlined {
        color: var(--primary);
        font-size: 1.8rem;
        flex-shrink: 0;
    }
    .espana-link .arrow {
        margin-left: auto;
        font-size: 1.3rem;
    }
    .espana-link strong {
        display: block;
        font-size: 1rem;
    }
    .espana-link small {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .province-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.6rem;
    }

    .province-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.6rem;
        text-decoration: none;
        color: var(--text);
        font-size: 0.9rem;
        transition: border-color 0.2s, color 0.2s;
    }

    .province-link:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .province-name {
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .province-count {
        font-size: 0.7rem;
        color: var(--text-muted);
        background: var(--bg);
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        flex-shrink: 0;
    }
</style>
