---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Página no encontrada | OCTO"
    description="La página que buscas no existe o ha cambiado de dirección."
    noindex={true}
>
    <main class="nf-page">
        <p class="nf-code">404</p>
        <h1>Esta página se quedó sin gasolina</h1>
        <p class="nf-lead">
            La dirección que buscas no existe o ha cambiado. Prueba desde el inicio
            o busca tu municipio para ver los precios de tu zona.
        </p>
        <div class="nf-actions">
            <a class="nf-cta" href="/">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                Volver al inicio
            </a>
            <a class="nf-ghost" href="/municipios">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                Buscar mi municipio
            </a>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .nf-page {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 6rem 1.5rem 4rem;
        background-color: var(--bg);
        color: var(--text);
    }
    .nf-code {
        font-family: var(--font-header);
        font-size: clamp(4rem, 12vw, 7rem);
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
        margin-bottom: 0.5rem;
    }
    h1 {
        font-size: clamp(1.3rem, 4vw, 1.8rem);
        margin-bottom: 0.75rem;
    }
    .nf-lead {
        color: var(--text-muted);
        max-width: 460px;
        line-height: 1.6;
        margin-bottom: 2rem;
    }
    .nf-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
    }
    .nf-cta,
    .nf-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.3rem;
        border-radius: 0.7rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.15s ease;
    }
    .nf-cta {
        background: var(--primary);
        color: #06281c;
    }
    .nf-cta:hover {
        filter: brightness(1.06);
    }
    .nf-ghost {
        color: var(--text);
        border: 1px solid var(--border);
    }
    .nf-ghost:hover {
        border-color: var(--primary);
        color: var(--primary);
    }
</style>
