---
import Layout from "../layouts/Layout.astro";
import ExplorerApp from "../components/Explorer/ExplorerApp";
---

<Layout
    title="Explorador de gasolineras en el mapa | OCTO"
    description="Explora en el mapa todas las gasolineras de España y compara precios de gasolina 95, 98, diésel, GLP y más. Ordena por precio o cercanía y encuentra la más barata."
    hideSidebar={true}
    hideHeaderLogo={true}
>
    {/* La descarga del JSON de estaciones arranca en paralelo con el JS de la isla. */}
    <link rel="preload" href="/data/stations.json" as="fetch" crossorigin="anonymous" slot="head" />
    {/* El explorador es todo mapa y no tiene título visible; este es para lectores de pantalla y buscadores. */}
    <h1 class="sr-only">Explorador de gasolineras en el mapa</h1>
    <ExplorerApp client:only="react" />
</Layout>
