---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import ExplorerSelector from "../components/Explorer/ExplorerSelector";
import NationalTopFuels, { type TopStation } from "../components/Home/NationalTopFuels";
import Footer from "../components/Footer.astro";
import { BRAND_LOGO_FILES } from "../lib/brandLogos";
import { FUEL_ORDER } from "../lib/fuels";
import type { GasStation, FuelType } from "../types/gasolinera";
import styles from "../styles/Home.module.css";

// --- Datos en vivo (build) para enriquecer la home ---
const stations = JSON.parse(
    fs.readFileSync(path.resolve("public/data/stations.json"), "utf-8")
) as GasStation[];

const provinces = new Set<string>();
const munis = new Set<string>();
const sp95: number[] = [];
const diesel: number[] = [];
for (const s of stations) {
    if (s.province) provinces.add(s.province);
    if (s.province && s.city) munis.add(`${s.province}|${s.city}`);
    if (s.prices.sp95 != null) sp95.push(s.prices.sp95);
    if (s.prices.diesel != null) diesel.push(s.prices.diesel);
}
const avg = (a: number[]) => (a.length ? a.reduce((x, y) => x + y, 0) / a.length : 0);
const nf = new Intl.NumberFormat("es-ES", { useGrouping: "always" });
const fmt = (n: number) => n.toFixed(3);

const totalStations = stations.length;
const totalProvinces = provinces.size;
const totalMunis = munis.size;
const avgSp95 = avg(sp95);
const avgDiesel = avg(diesel);
const minSp95 = sp95.length ? Math.min(...sp95) : 0;
// Ahorro real (dato calculado, no inventado): diferencia entre la media y la más barata.
const maxSavingSp95 = Math.max(0, avgSp95 - minSp95);

// --- Top 10 más baratas por combustible (España) ---
// Solo ofrecemos un combustible si hay suficientes estaciones para que un "top 10"
// tenga sentido real (evita un top degenerado con 1-2 gasolineras de hidrógeno, etc.).
const MIN_STATIONS_FOR_TOP = 20;
const topByFuel: Partial<Record<FuelType, TopStation[]>> = {};
for (const fuel of FUEL_ORDER) {
    const priced = stations.filter((s) => s.prices[fuel] != null);
    if (priced.length < MIN_STATIONS_FOR_TOP) continue;
    topByFuel[fuel] = [...priced]
        .sort((a, b) => a.prices[fuel]! - b.prices[fuel]!)
        .slice(0, 10)
        .map((s) => ({
            id: s.id,
            brand: s.brand,
            address: s.address,
            city: s.city,
            province: s.province,
            price: s.prices[fuel]!,
        }));
}

// Logos para el marquee (duplicados para scroll infinito).
const logoFiles = Object.values(BRAND_LOGO_FILES);

const features = [
    {
        icon: "explore",
        color: "var(--primary)",
        title: "Explorador de precios",
        desc: "Todas las gasolineras de España en un mapa interactivo. Filtra por combustible y marca, ordena por precio o cercanía y encuentra la más barata cerca de ti.",
        badge: `${nf.format(totalStations)} gasolineras en el mapa`,
        href: "/municipios",
        cta: "Explorar el mapa",
        size: "big",
    },
    {
        icon: "balance",
        color: "var(--secondary)",
        title: "Comparador",
        desc: "Pon hasta 4 gasolineras una al lado de otra y compáralas precio a precio: 95, 98, diésel, GLP y más.",
        badge: maxSavingSp95 > 0.01 ? `Ahorra hasta ${maxSavingSp95.toFixed(2)} €/L` : undefined,
        href: "/comparador",
        cta: "Abrir comparador",
    },
    {
        icon: "route",
        color: "var(--accent)",
        title: "Planificador de viajes",
        desc: "Calcula tu ruta y descubre dónde repostar más barato por el camino según tu consumo, depósito y peajes.",
        badge: undefined,
        href: "/rutas",
        cta: "Planificar ruta",
    },
    {
        icon: "pin_drop",
        color: "var(--primary)",
        title: "Fichas por provincia y gasolinera",
        desc: `Más de ${nf.format(totalStations)} fichas con precios, horario, mapa, evolución histórica y gasolineras cercanas. Páginas por provincia y municipio de toda España.`,
        badge: `${totalProvinces} provincias · ${nf.format(totalMunis)} municipios`,
        href: "/municipios",
        cta: "Ver por provincia",
        size: "wide",
    },
];

const steps = [
    {
        icon: "travel_explore",
        title: "Elige tu zona",
        desc: "Busca tu municipio o usa tu ubicación en tiempo real para ver las gasolineras de tu alrededor.",
    },
    {
        icon: "savings",
        title: "Compara precios",
        desc: "Visualízalas en el mapa, ordénalas por precio y compáralas cara a cara para cada combustible.",
    },
    {
        icon: "local_gas_station",
        title: "Reposta y ahorra",
        desc: "Ve a la más barata o planifica tu ruta para repostar al mejor precio durante el viaje.",
    },
];
---

<Layout
    title="OCTO - Gasolineras baratas en España | Menos gasto, más kilómetros"
    description="Encuentra las gasolineras más baratas de España. Compara precios de gasolina 95, 98, diésel y GLP en el mapa, comparador y planificador de rutas. Datos oficiales actualizados a diario."
    hideSidebar={true}
>
    <div class={styles.homeContainer} id="home-container">
        <!-- ===== HERO ===== -->
        <section class={styles.hero}>
            <video
                class={styles.heroVideo}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                aria-hidden="true"
            >
                {/* En pantallas estrechas (móvil) no hay fuente que coincida -> el
                    navegador no descarga los ~9MB del vídeo, solo se ve el velo oscuro. */}
                <source src="/videos/hero-road.mp4" type="video/mp4" media="(min-width: 700px)" />
            </video>
            <div class={styles.heroVideoOverlay}></div>

            <div class={styles.heroCenter} id="hero-logo">
                <div class={styles.logoBox}>
                    <img src="/images/logo-octo.webp" alt="OCTO Logo" class={styles.logoImage} width="540" height="201" fetchpriority="high" />
                </div>
                <h1 class={styles.slogan}>
                    Menos gasto, <span class={styles.sloganAccent}>más kilómetros</span>
                </h1>
                <p class={styles.heroLead}>
                    La forma más rápida de encontrar la gasolinera más barata de España.
                    Explora precios en el mapa, compara estaciones y planifica tu ruta para
                    repostar siempre al mejor precio.
                </p>

                <div class={styles.heroStats}>
                    <span class={styles.statChip}>
                        <span class="material-symbols-outlined" aria-hidden="true">local_gas_station</span>
                        <b>{nf.format(totalStations)}</b> gasolineras
                    </span>
                    <span class={styles.statChip}>
                        <span class="material-symbols-outlined" aria-hidden="true">map</span>
                        <b>{totalProvinces}</b> provincias
                    </span>
                    <span class={styles.statChip}>
                        <span class="material-symbols-outlined" aria-hidden="true">update</span>
                        Datos oficiales a diario
                    </span>
                </div>

                <div class={styles.heroSelectorWrap}>
                    <ExplorerSelector client:only="react" />
                </div>
            </div>

            <a href="#top10" class={styles.scrollIndicator} id="scroll-btn">
                <span>Descubre más</span>
                <span class={`material-symbols-outlined ${styles.scrollIcon}`} aria-hidden="true">expand_more</span>
            </a>
        </section>

        <!-- ===== MARQUEE DE MARCAS ===== -->
        <section class={styles.marquee} aria-label="Marcas de gasolineras">
            <p class={styles.marqueeLabel}>Comparamos los precios de todas las marcas</p>
            <div class={styles.marqueeTrack}>
                {
                    [...logoFiles, ...logoFiles].map((file) => (
                        <div class={styles.marqueeLogo}>
                            <img src={`/brands/${file}`} alt="" loading="lazy" />
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- ===== TOP 10 MÁS BARATAS (multi-combustible) ===== -->
        <section class={styles.section} id="top10">
            <div class={styles.inner}>
                <div class={styles.topFuelsLayout}>
                    <div class={`${styles.topFuelsText} reveal`}>
                        <span class={styles.eyebrow}>Datos en directo</span>
                        <h2 class={styles.sectionTitle}>
                            Las gasolineras más baratas de España, ahora mismo
                        </h2>
                        <p class={styles.sectionSubtitle}>
                            Elige el combustible y mira el top 10 nacional al instante: gasolina,
                            diésel, GLP y más. Datos oficiales actualizados a diario.
                        </p>
                        <a class={styles.topFuelsCta} href="/municipios">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                            Buscar en tu zona
                        </a>
                    </div>
                    <div class={`${styles.topFuelsWidget} reveal`}>
                        <NationalTopFuels client:visible topByFuel={topByFuel} />
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== FEATURES (bento) ===== -->
        <section class={styles.section} id="features">
            <div class={styles.inner}>
                <div class={`${styles.sectionHead} reveal`}>
                    <span class={styles.eyebrow}>Todo en un sitio</span>
                    <h2 class={styles.sectionTitle}>Qué puedes hacer con OCTO</h2>
                    <p class={styles.sectionSubtitle}>
                        Cuatro herramientas para gastar menos en combustible, con datos oficiales
                        del Ministerio actualizados cada día.
                    </p>
                </div>

                <div class={styles.featureGrid}>
                    {
                        features.map((f) => (
                            <a
                                class={`${styles.featureCard} ${f.size === "big" ? styles.cardBig : ""} ${f.size === "wide" ? styles.cardWide : ""} reveal`}
                                href={f.href}
                                style={`--accentColor:${f.color}`}
                            >
                                {f.size === "big" && (
                                    <span class={styles.pinCluster} aria-hidden="true">
                                        <i style="--d:0s" /><i style="--d:.6s" /><i style="--d:1.2s" />
                                    </span>
                                )}
                                <div class={styles.featureIcon}>
                                    <span class="material-symbols-outlined" aria-hidden="true">{f.icon}</span>
                                </div>
                                <div class={styles.featureBody}>
                                    <h3 class={styles.featureTitle}>{f.title}</h3>
                                    <p class={styles.featureDesc}>{f.desc}</p>
                                    {f.badge && <span class={styles.featureBadge}>{f.badge}</span>}
                                    <span class={styles.featureLink}>
                                        {f.cta}
                                        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ===== CÓMO FUNCIONA ===== -->
        <section class={styles.section}>
            <div class={styles.inner}>
                <div class={`${styles.sectionHead} reveal`}>
                    <span class={styles.eyebrow}>Así de fácil</span>
                    <h2 class={styles.sectionTitle}>Ahorrar te lleva 3 pasos</h2>
                </div>
                <div class={styles.steps}>
                    {
                        steps.map((s, i) => (
                            <div class={`${styles.step} reveal`}>
                                <div class={styles.stepNum}>{i + 1}</div>
                                <h3 class={styles.stepTitle}>{s.title}</h3>
                                <p class={styles.stepDesc}>{s.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ===== COBERTURA / CONFIANZA ===== -->
        <section class={`${styles.section} ${styles.coverage}`}>
            <div class={styles.inner}>
                <div class={`${styles.sectionHead} reveal`}>
                    <span class={styles.eyebrow}>Cobertura nacional</span>
                    <h2 class={styles.sectionTitle}>Toda España, datos oficiales</h2>
                </div>
                <div class={styles.statsGrid}>
                    <div class={`${styles.bigStat} reveal`}>
                        <span class={styles.bigStatValue}>{nf.format(totalStations)}</span>
                        <span class={styles.bigStatLabel}>Gasolineras</span>
                    </div>
                    <div class={`${styles.bigStat} reveal`}>
                        <span class={styles.bigStatValue}>{totalProvinces}</span>
                        <span class={styles.bigStatLabel}>Provincias</span>
                    </div>
                    <div class={`${styles.bigStat} reveal`}>
                        <span class={styles.bigStatValue}>{nf.format(totalMunis)}</span>
                        <span class={styles.bigStatLabel}>Municipios</span>
                    </div>
                    <div class={`${styles.bigStat} reveal`}>
                        <span class={styles.bigStatValue}>{fmt(avgSp95)}</span>
                        <span class={styles.bigStatLabel}>Media SP95 (€/L)</span>
                    </div>
                </div>
                <div class={styles.trustRow}>
                    <span class={styles.trustItem}>
                        <span class="material-symbols-outlined" aria-hidden="true">verified</span>
                        Datos del Ministerio (MITECO)
                    </span>
                    <span class={styles.trustItem}>
                        <span class="material-symbols-outlined" aria-hidden="true">update</span>
                        Actualizados a diario
                    </span>
                    <span class={styles.trustItem}>
                        <span class="material-symbols-outlined" aria-hidden="true">savings</span>
                        Media diésel {fmt(avgDiesel)} €/L
                    </span>
                </div>
            </div>
        </section>

        <!-- ===== CTA FINAL ===== -->
        <section class={`${styles.section} ${styles.ctaBand}`}>
            <div class={`${styles.ctaCard} reveal`}>
                <h2 class={styles.ctaTitle}>Empieza a ahorrar en cada repostaje</h2>
                <p class={styles.ctaText}>
                    Encuentra tu gasolinera más barata ahora mismo. Sin registros, gratis y con
                    los precios oficiales más recientes.
                </p>
                <ExplorerSelector client:only="react" />
            </div>
        </section>

        <Footer />
    </div>
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const homeContainer = document.getElementById("home-container");
        const header = document.getElementById("main-header");
        const headerLogo = document.getElementById("header-logo");
        const heroLogo = document.getElementById("hero-logo");

        // Animación de aparición al hacer scroll.
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

        // Header flotante + logo mini al hacer scroll.
        if (homeContainer) {
            homeContainer.addEventListener("scroll", () => {
                header?.setAttribute("data-scrolled", homeContainer.scrollTop > 50 ? "true" : "false");
                if (heroLogo) {
                    const heroRect = heroLogo.getBoundingClientRect();
                    headerLogo?.setAttribute("data-visible", heroRect.bottom < 0 ? "true" : "false");
                }
            });
        }
    });
</script>

<style>
    :global(.reveal.is-visible) {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }
    :global(header[data-scrolled="true"]) {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }
    :global([data-visible="true"]) {
        opacity: 1 !important;
        transform: translateX(0) !important;
    }
</style>
