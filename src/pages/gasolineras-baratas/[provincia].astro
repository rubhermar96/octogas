---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import Footer from "../../components/Footer.astro";
import CompareToggle from "../../components/CompareToggle.astro";
import { stationUrl, municipioUrl, provinceUrl } from "../../lib/stationUrl";
import RecentVisit from "../../components/Recent/RecentVisit.astro";
import RecentStrip from "../../components/Recent/RecentStrip.astro";
import { brandUrl, brandsInProvince } from "../../lib/brandPages";
import { placeSlug, displayProvince, displayCity } from "../../lib/placeName";
import PriceHistoryChart from "../../components/Station/PriceHistoryChart";
import { loadAggHistory, scopeKey } from "../../lib/aggHistory";
import { loadMissingStations } from "../../lib/missingStations";
import { provinceInsights, provinceInsightContext, type ProvinceInsightInput } from "../../lib/provinceInsights";
import { displayAddress } from "../../lib/format";
import { isGeneric } from "../../lib/insightText";
import FuelTable from "../../components/FuelTable.astro";
import { fuelSummary, fuelFaq, fuelFamilies, fuelPriceList } from "../../lib/fuelSummary";
import { FUEL_LABELS } from "../../lib/fuels";
import type { GasStation, FuelType } from "../../types/gasolinera";

interface Muni {
    name: string;
    slug: string;
    count: number;
    minSp95: number | null;
    minDiesel: number | null;
    /** Hoy ninguna de sus gasolineras ha publicado precios (ver missingStations.ts). */
    noPrices?: boolean;
}

export async function getStaticPaths() {
    const dataPath = path.resolve("public/data/stations.json");
    const stations = JSON.parse(fs.readFileSync(dataPath, "utf-8")) as GasStation[];

    const groups: Record<string, GasStation[]> = {};
    for (const s of stations) {
        if (!s.province) continue;
        (groups[s.province] ??= []).push(s);
    }
    // Municipios en los que hoy ninguna gasolinera ha publicado precios: su página se
    // mantiene unos días (ver missingStations.ts) y se enlaza al final de la lista.
    const missingCities: Record<string, Set<string>> = {};
    for (const s of loadMissingStations(stations)) (missingCities[s.province] ??= new Set()).add(s.city);

    // Texto propio de cada provincia (src/lib/provinceInsights.ts): medias y puesto de
    // todas las provincias para compararlas.
    const insightFor = provinceInsightContext(stations);

    return Object.entries(groups).map(([provinceName, list]) => {
        // Municipios de la provincia con su nº de estaciones y precio mínimo de gasolina 95
        // y de diésel.
        const byCity: Record<string, GasStation[]> = {};
        for (const s of list) {
            if (!s.city) continue;
            (byCity[s.city] ??= []).push(s);
        }
        const minOf = (l: GasStation[], f: "sp95" | "diesel") => {
            const v = l.map((x) => x.prices[f]).filter((p): p is number => p != null);
            return v.length ? Math.min(...v) : null;
        };
        const munis: Muni[] = Object.entries(byCity)
            .map(([name, l]) => ({
                name,
                slug: placeSlug(name),
                count: l.length,
                minSp95: minOf(l, "sp95"),
                minDiesel: minOf(l, "diesel"),
            }))
            .sort((a, b) => b.count - a.count);

        const known = new Set(munis.map((m) => m.slug));
        for (const name of missingCities[provinceName] ?? []) {
            const slug = placeSlug(name);
            if (known.has(slug)) continue;
            known.add(slug);
            munis.push({ name, slug, count: 0, minSp95: null, minDiesel: null, noPrices: true });
        }
        return {
            params: { provincia: placeSlug(provinceName) },
            props: { provinceName, stations: list, munis, insightInput: insightFor(provinceName) },
        };
    });
}

const { provinceName, stations, munis, insightInput } = Astro.props as {
    provinceName: string;
    stations: GasStation[];
    munis: Muni[];
    insightInput: ProvinceInsightInput;
};

const provLabel = displayProvince(provinceName);
// Marcas con página propia en la provincia (/marcas/repsol/madrid/).
const brandsHere = brandsInProvince(provinceName);

const aggHist = (await loadAggHistory()).get(scopeKey("province", placeSlug(provinceName))) ?? {};

// --- Precios por combustible: tabla, descripción y preguntas frecuentes (todos los
//     combustibles que se venden, no solo la gasolina 95) ---
const fuelRows = fuelSummary(stations);
const fmt = (n: number | null) => (n != null ? n.toFixed(3) : "—");
// Precio medio de los combustibles principales, en la barra de cifras.
const fuelAverages = fuelRows
    .filter((r) => (["sp95", "sp98", "diesel", "glp"] as FuelType[]).includes(r.fuel))
    .map((r) => ({ label: FUEL_LABELS[r.fuel], avg: r.avg }));

// Nombre legible (la marca, o la dirección si no tiene rótulo), no el rótulo en mayúsculas.
const labelOf = (s: GasStation) => (isGeneric(s) ? displayAddress(s.address) : s.brand);
// La más barata de la provincia para gasolina 95 y para diésel (una tarjeta si es la misma).
const r95 = fuelRows.find((r) => r.fuel === "sp95");
const rDiesel = fuelRows.find((r) => r.fuel === "diesel");
const cheapestCards =
    r95 && rDiesel && r95.cheapest.id === rDiesel.cheapest.id
        ? [{ tag: "Más barata en gasolina 95 y diésel", station: r95.cheapest, price: `SP95 ${fmt(r95.min)} · Diésel ${fmt(rDiesel.min)} €/L` }]
        : [
              ...(r95 ? [{ tag: "Más barata en gasolina 95", station: r95.cheapest, price: `${fmt(r95.min)} €/L` }] : []),
              ...(rDiesel ? [{ tag: "Más barata en diésel", station: rDiesel.cheapest, price: `${fmt(rDiesel.min)} €/L` }] : []),
          ];

// Texto propio de la provincia, sacado de sus datos (ver src/lib/provinceInsights.ts).
const insights = provinceInsights({ ...insightInput, history: aggHist });

const updated = new Date().toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const pageTitle = `Gasolineras baratas en ${provLabel} — Gasolina y diésel hoy por municipio | OCTO`;
const pageDescription = `Precios de hoy en las ${stations.length} gasolineras de la provincia de ${provLabel}: ${fuelPriceList(fuelRows)}. Encuentra la más barata de tu municipio. Datos oficiales, actualizados cada día.`;

const faq = [
    // La más barata según el combustible y una pregunta por cada combustible que se vende.
    ...fuelFaq(fuelRows, {
        label: provLabel,
        at: `en la provincia de ${provLabel}`,
        of: `la provincia de ${provLabel}`,
        stations,
        name: (s) => `${isGeneric(s) ? `la gasolinera de ${displayAddress(s.address)}` : `${s.brand}, en ${displayAddress(s.address)}`}, en ${displayCity(s.city)}`,
    }),
    {
        q: `¿Cuántas gasolineras hay en ${provLabel}?`,
        a: `Hay ${stations.length} estaciones de servicio repartidas en ${munis.length} municipios de la provincia de ${provLabel}.`,
    },
    // Puesto en España, municipios más baratos y tendencia (cuando hay dato).
    ...insights.faq,
];

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: "Municipios", item: new URL("/municipios/", Astro.site).href },
        { "@type": "ListItem", position: 3, name: provLabel, item: Astro.url.href },
    ],
};
---

<Layout title={pageTitle} description={pageDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
    <RecentVisit kind="provincia" url={provinceUrl(provinceName)} title={`Provincia de ${provLabel}`} sub="Gasolineras y municipios" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

    <div class="page-container">
        <div class="content-wrapper" data-reveal-children>
            <nav class="breadcrumb" aria-label="Migas de pan">
                <a href="/">Inicio</a>
                <span>›</span>
                <a href="/municipios/">Municipios</a>
                <span>›</span>
                <span class="current">{provLabel}</span>
            </nav>

            <header class="page-header">
                <h1>Gasolineras baratas en {provLabel}</h1>
                <p class="subtitle">
                    Precios de {fuelFamilies(fuelRows)} en {stations.length} estaciones de la provincia de
                    {provLabel}, repartidas en {munis.length} municipios. Elige tu municipio para ver
                    el detalle. <span class="updated">Actualizado el {updated}.</span>
                </p>
            </header>

            <section class="stats-bar" data-reveal-items aria-label="Resumen de precios">
                <div class="stat">
                    <span class="stat-label">Estaciones</span>
                    <span class="stat-value">{stations.length}</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Municipios</span>
                    <span class="stat-value">{munis.length}</span>
                </div>
                {
                    fuelAverages.map((f) => (
                        <div class="stat">
                            <span class="stat-label">Media {f.label}</span>
                            <span class="stat-value muted">{fmt(f.avg)} <small>€/L</small></span>
                        </div>
                    ))
                }
            </section>

            {
                cheapestCards.length > 0 && (
                    <div class="cheapest-row">
                        {cheapestCards.map((c) => (
                            <div class="cheapest hover-lift">
                                <span class="cheapest-tag">{c.tag}</span>
                                <a class="cheapest-name" href={stationUrl(c.station)}>{labelOf(c.station)}</a>
                                <span class="cheapest-meta">{displayCity(c.station.city)} · {c.price}</span>
                                <div class="cheapest-compare"><CompareToggle stationId={c.station.id} /></div>
                            </div>
                        ))}
                    </div>
                )
            }

            <FuelTable rows={fuelRows} place={`la provincia de ${provLabel}`} where="city" province={provinceName} />

            {
                insights.paragraphs.length > 0 && (
                    <section class="insights">
                        <h2>Cómo están los precios en {provLabel}</h2>
                        {insights.paragraphs.map((p) => (
                            <p>{p.map((part) => (typeof part === "string" ? part : <a href={part.href}>{part.text}</a>))}</p>
                        ))}
                    </section>
                )
            }

            <section class="chart-section">
                <h2>Evolución del precio medio en {provLabel}</h2>
                <PriceHistoryChart client:visible history={aggHist} />
            </section>

            <AdSlot slot="" label="Publicidad" minHeight={120} />

            <section class="munis">
                <h2>Municipios de {provLabel}</h2>
                <p class="section-note">Con el precio más bajo de hoy de gasolina 95 y de diésel en cada uno.</p>
                <div class="muni-grid" data-reveal-items>
                    {
                        munis.map((m) => (
                            <a href={municipioUrl(provinceName, m.name)} class="muni-link hover-lift">
                                <span class="muni-top">
                                    <span class="muni-name">{displayCity(m.name)}</span>
                                    {m.noPrices ? <span class="muni-missing">Sin precios hoy</span> : <span class="muni-count">{m.count}</span>}
                                </span>
                                {(m.minSp95 != null || m.minDiesel != null) && (
                                    <span class="muni-prices">
                                        {m.minSp95 != null && <span><b>{FUEL_LABELS.sp95}</b> {fmt(m.minSp95)}</span>}
                                        {m.minDiesel != null && <span><b>{FUEL_LABELS.diesel}</b> {fmt(m.minDiesel)}</span>}
                                    </span>
                                )}
                            </a>
                        ))
                    }
                </div>
            </section>

            {
                brandsHere.length > 0 && (
                    <section class="munis">
                        <h2>Gasolineras por marca en {provLabel}</h2>
                        <p class="section-note">
                            Con el precio medio de hoy de cada marca en la provincia. <a href="/marcas/">Qué marca es más barata en toda España</a>.
                        </p>
                        <div class="muni-grid" data-reveal-items>
                            {brandsHere.map(({ brand, province }) => (
                                <a href={brandUrl(brand, province)} class="muni-link hover-lift">
                                    <span class="muni-top">
                                        <span class="muni-name">{brand.name}</span>
                                        <span class="muni-count">{province.stations.length}</span>
                                    </span>
                                    {(province.avg.sp95 != null || province.avg.diesel != null) && (
                                        <span class="muni-prices">
                                            {province.avg.sp95 != null && <span><b>{FUEL_LABELS.sp95}</b> {fmt(province.avg.sp95)}</span>}
                                            {province.avg.diesel != null && <span><b>{FUEL_LABELS.diesel}</b> {fmt(province.avg.diesel)}</span>}
                                        </span>
                                    )}
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            <section class="faq" data-reveal-items>
                <h2>Preguntas frecuentes sobre el combustible en {provLabel}</h2>
                {
                    faq.map((f) => (
                        <details class="faq-item">
                            <summary>{f.q}</summary>
                            <p>{f.a}</p>
                        </details>
                    ))
                }
            </section>

            <RecentStrip />
        </div>
    </div>

    <Footer />
</Layout>

<style>
    .page-container {
        padding: 5rem 2rem 3rem;
        min-height: 100vh;
        background-color: var(--bg);
        color: var(--text);
    }
    .content-wrapper {
        max-width: 1500px;
        margin: 0 auto;
    }
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .breadcrumb a {
        color: var(--text-muted);
        text-decoration: none;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .breadcrumb .current {
        color: var(--text);
        font-weight: 600;
    }
    .page-header {
        margin-bottom: 2rem;
    }
    h1 {
        font-family: var(--font-header);
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        margin-bottom: 0.75rem;
        line-height: 1.1;
    }
    .subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        max-width: 760px;
    }
    .updated {
        color: var(--primary);
        font-weight: 600;
    }
    .stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.875rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .stat-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 700;
    }
    .stat-value {
        font-family: var(--font-header);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
    }
    .stat-value.muted {
        color: var(--text);
    }
    .stat-value small {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
    }
    /* Toda la tarjeta lleva a la ficha (el enlace del nombre se estira sobre ella con
       ::after) y el botón de comparar queda por encima. */
    /* Texto propio de la provincia (provinceInsights). */
    .insights {
        margin: 0 0 3rem;
    }
    .insights h2 {
        margin-bottom: 1rem;
    }
    .insights p {
        max-width: 72ch;
        margin-bottom: 0.9rem;
        line-height: 1.7;
        color: var(--text-muted);
    }
    .insights a {
        color: var(--text);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--primary);
        text-underline-offset: 3px;
    }
    .insights a:hover {
        color: var(--primary);
    }
    /* La más barata para gasolina 95 y para diésel: una tarjeta, o dos si son distintas. */
    .cheapest-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .cheapest {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        background: linear-gradient(135deg, rgba(52, 211, 153, 0.12), rgba(56, 189, 248, 0.08));
        border: 1px solid rgba(52, 211, 153, 0.4);
        border-radius: 1rem;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: var(--text);
        transition: transform 0.2s, border-color 0.2s;
    }
    .cheapest:hover {
        transform: translateY(-2px);
        border-color: var(--primary);
    }
    .cheapest-tag {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--primary);
        font-weight: 800;
    }
    .cheapest-name {
        color: inherit;
        text-decoration: none;
        font-family: var(--font-header);
        font-size: 1.2rem;
        font-weight: 700;
    }
    .cheapest-name::after {
        content: "";
        position: absolute;
        inset: 0;
    }
    .cheapest-compare {
        position: relative;
        z-index: 1;
        align-self: flex-start;
        margin-top: 0.5rem;
    }
    .cheapest-meta {
        font-size: 0.9rem;
        color: var(--text-muted);
    }
    section h2 {
        font-family: var(--font-header);
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
    }
    .chart-section {
        margin-bottom: 2.5rem;
    }
    .munis {
        margin-bottom: 3rem;
    }
    .muni-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem;
    }
    .section-note {
        margin: -1rem 0 1.25rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }
    .section-note a {
        color: var(--primary);
        font-weight: 600;
    }
    .muni-link {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 0.8rem 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.7rem;
        text-decoration: none;
        color: var(--text);
        font-size: 0.9rem;
        transition: border-color 0.2s, color 0.2s;
    }
    .muni-link:hover {
        border-color: var(--primary);
        color: var(--primary);
    }
    .muni-name {
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .muni-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        min-width: 0;
    }
    .muni-prices {
        display: flex;
        flex-wrap: wrap;
        gap: 0.1rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--primary);
        font-variant-numeric: tabular-nums;
    }
    .muni-prices b {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-right: 0.15rem;
    }
    .muni-missing {
        font-size: 0.72rem;
        color: var(--text-muted);
    }
    .muni-count {
        font-size: 0.7rem;
        color: var(--text-muted);
        background: var(--bg);
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
    }
    .faq {
        margin-bottom: 3rem;
    }
    .faq-item {
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        margin-bottom: 0.75rem;
        background: var(--surface);
        overflow: hidden;
    }
    .faq-item summary {
        padding: 1rem 1.25rem;
        font-weight: 700;
        cursor: pointer;
        color: var(--text);
        list-style: none;
    }
    .faq-item summary::-webkit-details-marker {
        display: none;
    }
    .faq-item summary::after {
        content: "+";
        float: right;
        color: var(--primary);
        font-weight: 800;
    }
    .faq-item[open] summary::after {
        content: "−";
    }
    .faq-item p {
        padding: 0 1.25rem 1.1rem;
        color: var(--text-muted);
        line-height: 1.6;
    }
</style>
