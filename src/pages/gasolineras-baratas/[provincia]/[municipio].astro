---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../../layouts/Layout.astro";
import MainMap from "../../../components/Map/MainMap";
import MunicipioTop from "../../../components/Municipio/MunicipioTop";
import AdSlot from "../../../components/AdSlot.astro";
import Footer from "../../../components/Footer.astro";
import CompareToggle from "../../../components/CompareToggle.astro";
import { stationUrl, provinceUrl } from "../../../lib/stationUrl";
import { placeSlug, displayProvince, displayCity } from "../../../lib/placeName";
import PriceHistoryChart from "../../../components/Station/PriceHistoryChart";
import { loadAggHistory, scopeKey } from "../../../lib/aggHistory";
import { displayAddress } from "../../../lib/format";
import {
    municipioInsights,
    nearbyFinder,
    type Alternative,
    type Averages,
    type MainFuel,
} from "../../../lib/municipioInsights";
import type { GasStation } from "../../../types/gasolinera";

interface Sibling {
    name: string;
    slug: string;
    count: number;
}

export async function getStaticPaths() {
    const dataPath = path.resolve("public/data/stations.json");
    const stations = JSON.parse(fs.readFileSync(dataPath, "utf-8")) as GasStation[];

    // Agrupa por provincia y municipio.
    const groups: Record<string, Record<string, GasStation[]>> = {};
    stations.forEach((station) => {
        const province = station.province;
        const city = station.city;
        if (!province || !city) return;
        (groups[province] ??= {})[city] ??= [];
        groups[province][city].push(station);
    });

    // Lista de municipios por provincia (para enlaces internos), ordenada por nº de estaciones.
    const provinceMunis: Record<string, Sibling[]> = {};
    for (const province in groups) {
        provinceMunis[province] = Object.entries(groups[province])
            .map(([name, list]) => ({ name, slug: placeSlug(name), count: list.length }))
            .sort((a, b) => b.count - a.count);
    }

    // Referencias para el texto propio de cada municipio (src/lib/municipioInsights.ts):
    // medias de su provincia y de España, y gasolineras cercanas de otros municipios.
    const averagesOf = (list: GasStation[]): Averages => {
        const out: Averages = {};
        for (const f of ["sp95", "diesel"] as MainFuel[]) {
            const v = list.map((s) => s.prices[f]).filter((p): p is number => p != null);
            if (v.length) out[f] = v.reduce((a, b) => a + b, 0) / v.length;
        }
        return out;
    };
    const nationalAvg = averagesOf(stations);
    const provinceStats: Record<string, { avg: Averages; count: number }> = {};
    for (const province in groups) {
        const list = Object.values(groups[province]).flat();
        provinceStats[province] = { avg: averagesOf(list), count: list.length };
    }
    const findNearby = nearbyFinder(stations);

    const paths = [];
    for (const provinceName in groups) {
        for (const municipalityName in groups[provinceName]) {
            const provSlug = placeSlug(provinceName);
            const muniSlug = placeSlug(municipalityName);
            if (!provSlug || !muniSlug) continue;

            const siblings = provinceMunis[provinceName]
                .filter((m) => m.slug !== muniSlug)
                .slice(0, 24);

            const muniStations = groups[provinceName][municipalityName];
            const located = muniStations.filter((s) => Number.isFinite(s.lat) && Number.isFinite(s.lng));
            const nearby = located.length
                ? findNearby(
                      located.reduce((a, s) => a + s.lat, 0) / located.length,
                      located.reduce((a, s) => a + s.lng, 0) / located.length,
                      (s) => s.province === provinceName && s.city === municipalityName
                  )
                : [];

            paths.push({
                params: { provincia: provSlug, municipio: muniSlug },
                props: {
                    provinceName,
                    municipalityName,
                    provSlug,
                    stations: muniStations,
                    siblings,
                    provinceAvg: provinceStats[provinceName].avg,
                    provinceCount: provinceStats[provinceName].count,
                    nationalAvg,
                    nearby,
                },
            });
        }
    }
    return paths;
}

const { provinceName, municipalityName, provSlug, stations, siblings, provinceAvg, provinceCount, nationalAvg, nearby } =
    Astro.props as {
        provinceName: string;
        municipalityName: string;
        provSlug: string;
        stations: GasStation[];
        siblings: Sibling[];
        provinceAvg: Averages;
        provinceCount: number;
        nationalAvg: Averages;
        nearby: Alternative[];
    };

// Nombre de provincia en formato "Título" (el dato viene en mayúsculas).
const provLabel = displayProvince(provinceName);
const muniLabel = displayCity(municipalityName);

const aggHist = (await loadAggHistory()).get(
    scopeKey("municipio", `${placeSlug(provinceName)}|${placeSlug(municipalityName)}`)
) ?? {};

// --- Estadísticas para contenido y FAQ ---
type FuelKey = "sp95" | "sp98" | "diesel" | "glp";
const min = (key: FuelKey) => {
    const vals = stations.map((s) => s.prices[key]).filter((p): p is number => p != null);
    return vals.length ? Math.min(...vals) : null;
};
const avg = (key: FuelKey) => {
    const vals = stations.map((s) => s.prices[key]).filter((p): p is number => p != null);
    return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
};
const fmt = (n: number | null) => (n != null ? n.toFixed(3) : "—");
// En los textos (descripción y preguntas frecuentes), con coma decimal como en el resto
// de la redacción; las cifras de la interfaz siguen con punto, como en toda la web.
const fmtText = (n: number | null) => (n != null ? n.toLocaleString("es-ES", { minimumFractionDigits: 3, maximumFractionDigits: 3 }) : "—");

const minSp95 = min("sp95");
const minDiesel = min("diesel");
const avgSp95 = avg("sp95");
const avgDiesel = avg("diesel");

// Precio medio de cada combustible disponible en el municipio.
const fuelAverages = (
    [
        ["sp95", "SP95"],
        ["sp98", "SP98"],
        ["diesel", "Diésel"],
        ["glp", "GLP"],
    ] as [FuelKey, string][]
)
    .map(([key, label]) => ({ key, label, avg: avg(key) }))
    .filter((x) => x.avg != null);

const cheapestSp95Station = stations
    .filter((s) => s.prices.sp95 != null)
    .sort((a, b) => a.prices.sp95! - b.prices.sp95!)[0];
const cheapestSp95Label = cheapestSp95Station
    ? /^n[ºo°]/i.test(cheapestSp95Station.brand) || /^\d/.test(cheapestSp95Station.brand)
        ? `la gasolinera de ${displayAddress(cheapestSp95Station.address)}`
        : `${cheapestSp95Station.brand}, en ${displayAddress(cheapestSp95Station.address)}`
    : "";

// Texto propio del municipio, sacado de sus datos (ver src/lib/municipioInsights.ts).
const insights = municipioInsights({
    muni: muniLabel,
    prov: provLabel,
    slug: placeSlug(municipalityName),
    stations,
    provinceAvg,
    provinceCount,
    nationalAvg,
    history: aggHist,
    nearby,
});

const centerLat = stations.reduce((s, x) => s + x.lat, 0) / stations.length;
const centerLng = stations.reduce((s, x) => s + x.lng, 0) / stations.length;

const explorerUrl = `/explorador/?mode=municipality&prov=${encodeURIComponent(
    provinceName
)}&city=${encodeURIComponent(municipalityName)}`;

const updated = new Date().toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const pageTitle = `Gasolineras baratas en ${muniLabel} (${provLabel}) — Precios hoy | OCTO`;
const pageDescription = `Compara el precio de la gasolina 95 y el diésel en ${stations.length} gasolineras de ${muniLabel}, ${provLabel}. La más barata desde ${fmtText(minSp95)} €/L. Datos oficiales actualizados.`;

// --- Datos estructurados (FAQ + Breadcrumb) ---
const faq = [
    {
        q: `¿Cuál es la gasolinera más barata en ${muniLabel}?`,
        a: cheapestSp95Station
            ? `Actualmente la más barata para gasolina 95 es ${cheapestSp95Label}, a ${fmtText(minSp95)} €/L.`
            : `Consulta el listado actualizado de gasolineras en ${muniLabel} para ver la más barata.`,
    },
    {
        q: `¿Cuánto cuesta la gasolina 95 en ${muniLabel}?`,
        a: `El precio medio de la gasolina 95 en ${muniLabel} es de ${fmtText(avgSp95)} €/L, y el más bajo, ${fmtText(minSp95)} €/L.`,
    },
    {
        q: `¿Cuánto cuesta el diésel en ${muniLabel}?`,
        a: `El precio medio del gasóleo A (diésel) en ${muniLabel} es de ${fmtText(avgDiesel)} €/L, con un mínimo de ${fmtText(minDiesel)} €/L.`,
    },
    {
        q: `¿Cuántas gasolineras hay en ${muniLabel}?`,
        a: `Hay ${stations.length} estaciones de servicio con precios disponibles en ${muniLabel}.`,
    },
    // Zona más barata, tendencia del mes y alternativas cercanas (cuando hay dato).
    ...insights.faq,
    {
        q: `¿Con qué frecuencia se actualizan los precios?`,
        a: `Los precios se actualizan a diario a partir de los datos oficiales del Ministerio para la Transición Ecológica.`,
    },
];

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
        // Las mismas migas que se ven en la página: Inicio › Provincia › Municipio.
        {
            "@type": "ListItem",
            position: 2,
            name: provLabel,
            item: new URL(provinceUrl(provinceName), Astro.site).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: muniLabel,
            item: new URL(Astro.url.pathname, Astro.site).href,
        },
    ],
};
---

<Layout title={pageTitle} description={pageDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

    <div class="page-container">
        <div class="content-wrapper" data-reveal-children>
            <nav class="breadcrumb" aria-label="Migas de pan">
                <a href="/">Inicio</a>
                <span>›</span>
                <a href={provinceUrl(provinceName)}>{provLabel}</a>
                <span>›</span>
                <span class="current">{muniLabel}</span>
            </nav>

            <header class="page-header">
                <h1>Gasolineras baratas en {muniLabel}</h1>
                <p class="subtitle">
                    Precios de gasolina y diésel en {muniLabel}, {provLabel}.
                    Comparamos {stations.length} estaciones de servicio para que encuentres la
                    más barata. <span class="updated">Actualizado el {updated}.</span>
                </p>
            </header>

            <section class="stats-bar" data-reveal-items aria-label="Precio medio por combustible">
                <div class="stat">
                    <span class="stat-label">Estaciones</span>
                    <span class="stat-value">{stations.length}</span>
                </div>
                {
                    fuelAverages.map((f) => (
                        <div class="stat">
                            <span class="stat-label">Media {f.label}</span>
                            <span class="stat-value muted">{fmt(f.avg)} <small>€/L</small></span>
                        </div>
                    ))
                }
            </section>

            <MunicipioTop client:load stations={stations} explorerUrl={explorerUrl} />

            {
                insights.paragraphs.length > 0 && (
                    <section class="insights">
                        <h2>Cómo están los precios en {muniLabel}</h2>
                        {insights.paragraphs.map((p) => (
                            <p>{p.map((part) => (typeof part === "string" ? part : <a href={part.href}>{part.text}</a>))}</p>
                        ))}
                    </section>
                )
            }

            <section class="chart-section">
                <h2>Evolución del precio medio en {muniLabel}</h2>
                <PriceHistoryChart client:visible history={aggHist} />
            </section>

            <AdSlot slot="" label="Publicidad" minHeight={120} />

            <section class="map-section">
                <div class="map-wrapper">
                    <MainMap
                        client:only="react"
                        stations={stations}
                        initialCenter={[centerLat, centerLng]}
                        initialZoom={13}
                        disableGeolocation={true}
                    />
                </div>
            </section>

            <section class="faq" data-reveal-items>
                <h2>Preguntas frecuentes sobre el precio del combustible en {muniLabel}</h2>
                {
                    faq.map((f) => (
                        <details class="faq-item">
                            <summary>{f.q}</summary>
                            <p>{f.a}</p>
                        </details>
                    ))
                }
            </section>

            <section class="all-stations">
                <h2>Todas las gasolineras de {muniLabel}</h2>
                <div class="station-link-grid" data-reveal-items>
                    {
                        stations.map((s) => (
                            <div class="station-link hover-lift">
                                <a href={stationUrl(s)} class="sl-name">{/^n[ºo°]/i.test(s.brand) || /^\d/.test(s.brand) ? s.address : s.brand}</a>
                                <span class="sl-meta">
                                    {s.prices.sp95 != null && <span class="sl-price">{fmt(s.prices.sp95)} €/L</span>}
                                </span>
                                <div class="sl-compare"><CompareToggle stationId={s.id} variant="square" /></div>
                            </div>
                        ))
                    }
                </div>
            </section>

            {
                siblings.length > 0 && (
                    <section class="siblings">
                        <h2>Gasolineras en otros municipios de {provLabel}</h2>
                        <div class="sibling-grid" data-reveal-items>
                            {siblings.map((m) => (
                                <a href={`/gasolineras-baratas/${provSlug}/${m.slug}/`} class="sibling-link hover-lift">
                                    {displayCity(m.name)}
                                    <span>{m.count}</span>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }
        </div>
    </div>

    <Footer />
</Layout>

<style>
    .page-container {
        padding: 5rem 2rem 3rem;
        min-height: 100vh;
        background-color: var(--bg);
        color: var(--text);
    }

    .content-wrapper {
        max-width: 1500px;
        margin: 0 auto;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .breadcrumb a {
        color: var(--text-muted);
        text-decoration: none;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .breadcrumb .current {
        color: var(--text);
        font-weight: 600;
    }

    .page-header {
        margin-bottom: 2rem;
    }
    h1 {
        font-family: var(--font-header);
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        margin-bottom: 0.75rem;
        line-height: 1.1;
    }
    .subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        max-width: 760px;
    }
    .updated {
        color: var(--primary);
        font-weight: 600;
    }

    .stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 3rem;
    }
    .stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.875rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .stat-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 700;
    }
    .stat-value {
        font-family: var(--font-header);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
    }
    .stat-value.muted {
        color: var(--text);
    }
    .stat-value small {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
    }

    section h2 {
        font-family: var(--font-header);
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .stations-list {
        margin-bottom: 2rem;
    }
    .list-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
    }
    .station-card {
        background: var(--surface);
        padding: 1.25rem;
        border-radius: 0.875rem;
        border: 1px solid var(--border);
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        transition: border-color 0.2s, transform 0.2s;
    }
    .station-card:hover {
        border-color: rgba(52, 211, 153, 0.4);
        transform: translateY(-2px);
    }
    .rank {
        font-family: var(--font-header);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-muted);
        opacity: 0.5;
    }
    .details {
        flex: 1;
        min-width: 0;
    }
    .details h3 {
        font-size: 1rem;
        margin-bottom: 0.1rem;
    }
    .brand {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 0.4rem;
    }
    .address {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
    }
    .prices {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }
    .price-badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(52, 211, 153, 0.1);
        padding: 0.4rem 0.7rem;
        border-radius: 0.6rem;
        flex: 1;
    }
    .price-badge.alt {
        background: var(--bg);
    }
    .ptype {
        font-size: 0.6rem;
        font-weight: 700;
        color: var(--text-muted);
    }
    .price {
        font-weight: 800;
        font-size: 1rem;
        color: var(--text);
    }
    .route {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--secondary);
        text-decoration: none;
    }
    .route:hover {
        text-decoration: underline;
    }
    .cta-explore {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.8rem 1.5rem;
        background: var(--primary);
        color: var(--on-primary);
        font-weight: 700;
        border-radius: 0.75rem;
        text-decoration: none;
    }
    .cta-explore:hover {
        box-shadow: 0 0 20px rgba(52, 211, 153, 0.4);
    }

    .chart-section {
        margin-bottom: 3rem;
    }
    /* Texto propio del municipio (municipioInsights). */
    .insights {
        margin: 2.5rem 0 3rem;
    }
    .insights h2 {
        margin-bottom: 1rem;
    }
    .insights p {
        max-width: 72ch;
        margin-bottom: 0.9rem;
        line-height: 1.7;
        color: var(--text-muted);
    }
    .insights a {
        color: var(--text);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--primary);
        text-underline-offset: 3px;
    }
    .insights a:hover {
        color: var(--primary);
    }
    .map-section {
        height: 460px;
        margin: 1rem 0 3rem;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid var(--border);
    }
    .map-wrapper {
        height: 100%;
        width: 100%;
    }

    .faq {
        margin-bottom: 3rem;
    }
    .faq-item {
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        margin-bottom: 0.75rem;
        background: var(--surface);
        overflow: hidden;
    }
    .faq-item summary {
        padding: 1rem 1.25rem;
        font-weight: 700;
        cursor: pointer;
        color: var(--text);
        list-style: none;
    }
    .faq-item summary::-webkit-details-marker {
        display: none;
    }
    .faq-item summary::after {
        content: "+";
        float: right;
        color: var(--primary);
        font-weight: 800;
    }
    .faq-item[open] summary::after {
        content: "−";
    }
    .faq-item p {
        padding: 0 1.25rem 1.1rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .all-stations {
        margin-bottom: 3rem;
    }
    .station-link-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 0.6rem;
    }
    /* Toda la fila lleva a la ficha (el enlace del nombre se estira sobre ella con
       ::after) y el botón de comparar queda por encima. */
    .station-link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.45rem 0.45rem 0.45rem 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.7rem;
        text-decoration: none;
        color: var(--text);
        transition: border-color 0.2s, transform 0.2s;
    }
    .station-link:hover {
        border-color: var(--primary);
        transform: translateY(-1px);
    }
    .sl-name {
        flex: 1;
        min-width: 0;
        color: inherit;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .sl-name::after {
        content: "";
        position: absolute;
        inset: 0;
    }
    .sl-compare {
        position: relative;
        z-index: 1;
        display: flex;
    }
    .sl-price {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--primary);
        flex-shrink: 0;
    }

    .siblings {
        margin-bottom: 3rem;
    }
    .sibling-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.6rem;
    }
    .sibling-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.6rem;
        text-decoration: none;
        color: var(--text);
        font-size: 0.875rem;
        transition: border-color 0.2s, color 0.2s;
    }
    .sibling-link:hover {
        border-color: var(--primary);
        color: var(--primary);
    }
    .sibling-link span {
        font-size: 0.7rem;
        color: var(--text-muted);
        background: var(--bg);
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
    }
</style>
