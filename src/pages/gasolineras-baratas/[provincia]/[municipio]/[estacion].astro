---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../../../layouts/Layout.astro";
import MainMap from "../../../../components/Map/MainMap";
import AdSlot from "../../../../components/AdSlot.astro";
import Footer from "../../../../components/Footer.astro";
import CompareToggle from "../../../../components/CompareToggle.astro";
import { slugify } from "../../../../lib/slug";
import { stationSlug, stationUrl, provinceUrl, municipioUrl } from "../../../../lib/stationUrl";
import { placeSlug, displayProvince, displayCity } from "../../../../lib/placeName";
import { displayAddress } from "../../../../lib/format";
import { getDistance } from "../../../../lib/geo";
import { FUEL_LABELS, FUEL_ORDER } from "../../../../lib/fuels";
import { BRAND_LOGO_FILES } from "../../../../lib/brandLogos";
import { loadPriceHistory, type StationHistory } from "../../../../lib/history";
import PriceHistoryChart from "../../../../components/Station/PriceHistoryChart";
import { loadMissingStations, lastSeenLabel, type MissingStation } from "../../../../lib/missingStations";
import { stationInsights, stationInsightContext, type StationInsightInput } from "../../../../lib/stationInsights";
import { openingHours } from "../../../../lib/insightText";
import type { GasStation, FuelType } from "../../../../types/gasolinera";

export async function getStaticPaths() {
    const dataPath = path.resolve("public/data/stations.json");
    const stations = JSON.parse(fs.readFileSync(dataPath, "utf-8")) as GasStation[];
    // Las que hoy no publican precios pero sí en los últimos días conservan su ficha
    // (con aviso). Medias y cercanas salen solo de las de hoy.
    const missing = loadMissingStations(stations);
    // Texto propio de cada ficha (src/lib/stationInsights.ts): se compara siempre con
    // las gasolineras que tienen precios hoy.
    const insightFor = stationInsightContext(stations);

    // Medias por municipio (para comparar el precio de la estación).
    const muniAgg = new Map<string, { sp95: number[]; diesel: number[]; count: number }>();
    const muniKey = (s: GasStation) => `${slugify(s.province)}|${slugify(s.city)}`;
    for (const s of stations) {
        const k = muniKey(s);
        let a = muniAgg.get(k);
        if (!a) {
            a = { sp95: [], diesel: [], count: 0 };
            muniAgg.set(k, a);
        }
        a.count++;
        if (s.prices.sp95 != null) a.sp95.push(s.prices.sp95);
        if (s.prices.diesel != null) a.diesel.push(s.prices.diesel);
    }
    const mean = (arr: number[]) => (arr.length ? arr.reduce((x, y) => x + y, 0) / arr.length : null);

    // Rejilla espacial para buscar gasolineras cercanas rápido.
    const CELL = 0.12; // ~13 km
    const grid = new Map<string, GasStation[]>();
    const cellKey = (lat: number, lng: number) => `${Math.round(lat / CELL)}|${Math.round(lng / CELL)}`;
    for (const s of stations) {
        const k = cellKey(s.lat, s.lng);
        let arr = grid.get(k);
        if (!arr) {
            arr = [];
            grid.set(k, arr);
        }
        arr.push(s);
    }
    const nearbyOf = (s: GasStation): GasStation[] => {
        const ci = Math.round(s.lat / CELL);
        const cj = Math.round(s.lng / CELL);
        const cand: GasStation[] = [];
        for (let di = -1; di <= 1; di++) {
            for (let dj = -1; dj <= 1; dj++) {
                const arr = grid.get(`${ci + di}|${cj + dj}`);
                if (arr) cand.push(...arr);
            }
        }
        return cand
            .filter((x) => x.id !== s.id)
            .map((x) => ({ x, d: getDistance(s.lat, s.lng, x.lat, x.lng) }))
            .sort((a, b) => a.d - b.d)
            .slice(0, 6)
            .map(({ x }) => x);
    };

    // Histórico de precios (una sola consulta a Postgres, cacheada). Si no hay BD,
    // devuelve vacío y las fichas se generan sin gráfica.
    const history = await loadPriceHistory();

    // Gasolineras indistinguibles por marca, dirección, municipio y margen (MITECO
    // tiene alguna registrada dos veces a pocos metros): llevarán su número oficial.
    const sameKey = (s: GasStation) => `${s.brand}|${s.address}|${s.city}|${s.margin ?? ""}`.toLowerCase();
    const sameCount = new Map<string, number>();
    for (const s of [...stations, ...missing]) sameCount.set(sameKey(s), (sameCount.get(sameKey(s)) ?? 0) + 1);

    return [...stations, ...missing].map((station) => {
        const agg = muniAgg.get(muniKey(station));
        return {
            params: {
                provincia: placeSlug(station.province),
                municipio: placeSlug(station.city),
                estacion: stationSlug(station),
            },
            props: {
                station,
                nearby: nearbyOf(station),
                muniAvgSp95: mean(agg?.sp95 ?? []),
                muniAvgDiesel: mean(agg?.diesel ?? []),
                muniCount: agg?.count ?? 1,
                history: history.get(station.id) ?? null,
                showId: (sameCount.get(sameKey(station)) ?? 0) > 1,
                lastSeen: (station as MissingStation).lastSeen ?? null,
                insightInput: insightFor(station, {
                    lastSeen: (station as MissingStation).lastSeen ?? null,
                    muni: displayCity(station.city),
                    prov: displayProvince(station.province),
                    history: history.get(station.id) ?? null,
                }),
            },
        };
    });
}

const { station, nearby, muniAvgSp95, muniAvgDiesel, muniCount, history, showId, lastSeen, insightInput } = Astro.props as {
    station: GasStation;
    nearby: GasStation[];
    muniAvgSp95: number | null;
    muniAvgDiesel: number | null;
    muniCount: number;
    history: StationHistory | null;
    showId: boolean;
    lastSeen: string | null; // solo si hoy no ha publicado precios
    insightInput: StationInsightInput;
};
const insights = stationInsights(insightInput);
// Hoy no viene en los datos del Ministerio: se enseñan sus últimos precios, con fecha.
const lastSeenText = lastSeen ? lastSeenLabel(lastSeen) : null;

const provLabel = displayProvince(station.province);
const cityLabel = displayCity(station.city);
const addressLabel = displayAddress(station.address);
// Solo viene en las parejas de autovía con la misma marca y dirección (una por sentido).
const marginText = station.margin === "D" ? "margen derecho" : station.margin === "I" ? "margen izquierdo" : "";
// Lo que distingue a esta gasolinera de otra con la misma dirección (si hace falta).
const distinctText = [marginText, showId ? `n.º ${station.id}` : ""].filter(Boolean).join(", ");
const fmt = (n: number | null | undefined) => (n != null ? n.toFixed(3) : "—");

// ¿Tiene marca "de verdad" o es una independiente sin rótulo (p. ej. "Nº 10.935")?
const genericBrand = /^n[ºo°]/i.test(station.brand) || /^\d/.test(station.brand);
const brandLabel = genericBrand ? "" : station.brand;
const logoFile = BRAND_LOGO_FILES[slugify(station.brand)];

const availableFuels = FUEL_ORDER.filter((f) => station.prices[f] != null) as FuelType[];

// Comparación con la media del municipio.
const cmp = (price: number | null, avg: number | null) => {
    if (price == null || avg == null || avg === 0) return null;
    const diffPct = ((price - avg) / avg) * 100;
    return { diffPct, cheaper: price < avg };
};
// Sin precios de hoy no se compara con la media de hoy.
const sp95Cmp = lastSeen ? null : cmp(station.prices.sp95, muniAvgSp95);
const dieselCmp = lastSeen ? null : cmp(station.prices.diesel, muniAvgDiesel);

const updated = new Date().toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const h1 = brandLabel ? `Gasolinera ${brandLabel}` : "Gasolinera";
const pageTitle = `${h1} en ${addressLabel}, ${cityLabel}${distinctText ? ` (${distinctText})` : ""} | OCTO`;
const pageDescription = lastSeenText
    ? `${brandLabel || "La gasolinera"} de ${addressLabel}, ${cityLabel} (${provLabel})${distinctText ? `, ${distinctText}` : ""}, no ha publicado precios hoy. Últimos precios, del ${lastSeenText}: gasolina 95 a ${fmt(station.prices.sp95)} €/L y diésel a ${fmt(station.prices.diesel)} €/L. Horario, mapa y gasolineras cercanas con precios de hoy.`
    : `Precios de hoy de ${brandLabel || "la gasolinera"} en ${addressLabel}, ${cityLabel} (${provLabel})${distinctText ? `, ${distinctText}` : ""}: gasolina 95 a ${fmt(station.prices.sp95)} €/L y diésel a ${fmt(station.prices.diesel)} €/L. Horario, mapa y gasolineras cercanas.`;

const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${station.lat},${station.lng}`;

// --- Datos estructurados ---
const gasStationJsonLd = {
    "@context": "https://schema.org",
    "@type": "GasStation",
    name: brandLabel ? `${brandLabel} - ${cityLabel}` : `Gasolinera ${addressLabel}`,
    address: {
        "@type": "PostalAddress",
        streetAddress: addressLabel,
        addressLocality: cityLabel,
        addressRegion: provLabel,
        postalCode: station.postalCode || undefined,
        addressCountry: "ES",
    },
    geo: { "@type": "GeoCoordinates", latitude: station.lat, longitude: station.lng },
    url: new URL(stationUrl(station), Astro.site).href,
    brand: brandLabel ? { "@type": "Brand", name: brandLabel } : undefined,
    openingHours: openingHours(station.schedule),
};

const faq = [
    {
        q: `¿Cuánto cuesta la gasolina 95 en ${brandLabel || cityLabel}?`,
        a: lastSeenText
            ? `Hoy no ha publicado precios. ${station.prices.sp95 != null ? `El último precio de la gasolina 95 fue ${fmt(station.prices.sp95)} €/L, el ${lastSeenText}.` : `Su última actualización fue el ${lastSeenText}.`}`
            : station.prices.sp95 != null
                ? `La Gasolina 95 está a ${fmt(station.prices.sp95)} €/L en ${addressLabel}, ${cityLabel}${sp95Cmp ? `, un ${Math.abs(sp95Cmp.diffPct).toFixed(1)}% ${sp95Cmp.cheaper ? "más barata" : "más cara"} que la media del municipio` : ""}.`
                : `Esta estación no tiene precio de Gasolina 95 disponible actualmente.`,
    },
    {
        q: `¿Cuál es el horario de esta gasolinera?`,
        a: station.schedule ? `El horario es: ${station.schedule}.` : `El horario no está disponible.`,
    },
    ...insights.faq,
    {
        q: `¿Cómo llego a esta gasolinera?`,
        a: `Está en ${addressLabel}, ${station.postalCode || ""} ${cityLabel} (${provLabel}). Puedes abrir la ruta en Google Maps desde el botón "Cómo llegar".`,
    },
];
const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};
const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: provLabel, item: new URL(provinceUrl(station.province), Astro.site).href },
        { "@type": "ListItem", position: 3, name: cityLabel, item: new URL(municipioUrl(station.province, station.city), Astro.site).href },
        { "@type": "ListItem", position: 4, name: h1, item: Astro.url.href },
    ],
};

// En el mapa, sin precios viejos: el marcador sale gris ("sin dato").
const mapStations = [lastSeen ? { ...station, prices: {} } : station, ...nearby];
---

<Layout title={pageTitle} description={pageDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(gasStationJsonLd)} slot="head" />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

    <div class="page-container">
        <div class="content-wrapper" data-reveal-children>
            <nav class="breadcrumb" aria-label="Migas de pan">
                <a href="/">Inicio</a>
                <span>›</span>
                <a href={provinceUrl(station.province)}>{provLabel}</a>
                <span>›</span>
                <a href={municipioUrl(station.province, station.city)}>{cityLabel}</a>
                <span>›</span>
                <span class="current">{brandLabel || addressLabel}</span>
            </nav>

            <header class="station-header">
                <div class="logo-box">
                    {
                        logoFile ? (
                            <img src={`/brands/${logoFile}`} alt={brandLabel || "Gasolinera"} />
                        ) : (
                            <span class="material-symbols-outlined" aria-hidden="true">local_gas_station</span>
                        )
                    }
                </div>
                <div class="head-text">
                    <h1>{h1} en {cityLabel}</h1>
                    <p class="address">
                        <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                        {addressLabel}{station.postalCode ? `, ${station.postalCode}` : ""} {cityLabel} ({provLabel}){distinctText && ` · ${distinctText}`}
                    </p>
                    <p class="updated">{lastSeenText ? `Sin precios hoy · últimos publicados el ${lastSeenText}` : `Precios actualizados el ${updated}`}</p>
                </div>
                <div class="head-actions">
                    <a class="route-btn btn-pop" href={mapsUrl} target="_blank" rel="noopener noreferrer">
                        <span class="material-symbols-outlined" aria-hidden="true">directions</span>
                        Cómo llegar
                    </a>
                    {/* El comparador trabaja con los precios de hoy. */}
                    {!lastSeen && <CompareToggle stationId={station.id} variant="large" />}
                </div>
            </header>

            {
                lastSeenText && (
                    <p class="no-prices" role="status">
                        Esta gasolinera no ha publicado precios hoy en el Ministerio para la Transición Ecológica.
                        Debajo tienes los últimos que publicó, del {lastSeenText}, y las gasolineras más cercanas con
                        precios de hoy.
                    </p>
                )
            }

            {
                station.saleType === "R" && (
                    <p class="restricted">⚠ Venta restringida (cooperativa o flota). Puede no estar abierta al público general.</p>
                )
            }

            <section class="prices-section" aria-label="Precios por combustible">
                <h2>{lastSeenText ? `Últimos precios publicados (${lastSeenText})` : "Precios de hoy"}</h2>
                <div class="price-grid" data-reveal-items>
                    {
                        availableFuels.map((f) => (
                            <div class:list={["price-card", { stale: lastSeen }]}>
                                <span class="ptype">{FUEL_LABELS[f]}</span>
                                <span class="pval">{fmt(station.prices[f])} <small>€/L</small></span>
                            </div>
                        ))
                    }
                </div>

                {
                    (sp95Cmp || dieselCmp) && (
                        <div class="compare-row">
                            {sp95Cmp && (
                                <span class={`cmp ${sp95Cmp.cheaper ? "good" : "bad"}`}>
                                    Gasolina 95: {Math.abs(sp95Cmp.diffPct).toFixed(1)}% {sp95Cmp.cheaper ? "más barata" : "más cara"} que la media de {cityLabel}
                                </span>
                            )}
                            {dieselCmp && (
                                <span class={`cmp ${dieselCmp.cheaper ? "good" : "bad"}`}>
                                    Diésel: {Math.abs(dieselCmp.diffPct).toFixed(1)}% {dieselCmp.cheaper ? "más barato" : "más caro"} que la media de {cityLabel}
                                </span>
                            )}
                        </div>
                    )
                }
            </section>

            {
                insights.paragraphs.length > 0 && (
                    <section class="insights">
                        <h2>{lastSeen ? "Qué sabemos de esta gasolinera" : "Cómo está de precio esta gasolinera"}</h2>
                        {insights.paragraphs.map((p) => (
                            <p>{p.map((part) => (typeof part === "string" ? part : <a href={part.href}>{part.text}</a>))}</p>
                        ))}
                    </section>
                )
            }

            <section class="history-section">
                <h2>Evolución del precio</h2>
                <PriceHistoryChart client:visible history={history ?? {}} />
            </section>

            <section class="info-grid" data-reveal-items>
                <div class="info-card">
                    <span class="info-label">Horario</span>
                    <span class="info-value">{station.schedule || "No disponible"}</span>
                </div>
                {
                    brandLabel && (
                        <div class="info-card">
                            <span class="info-label">Marca</span>
                            <span class="info-value">{brandLabel}</span>
                        </div>
                    )
                }
                <div class="info-card">
                    <span class="info-label">Municipio</span>
                    <a class="info-value link" href={municipioUrl(station.province, station.city)}>
                        {cityLabel} ({muniCount} gasolineras)
                    </a>
                </div>
            </section>

            <AdSlot slot="" label="Publicidad" minHeight={120} />

            <section class="map-section">
                <h2>Ubicación y gasolineras cercanas</h2>
                <div class="map-wrapper">
                    <MainMap
                        client:only="react"
                        stations={mapStations}
                        initialCenter={[station.lat, station.lng]}
                        initialZoom={14}
                        disableGeolocation={true}
                        selectedId={station.id}
                    />
                </div>
            </section>

            {
                nearby.length > 0 && (
                    <section class="nearby">
                        <h2>Gasolineras cercanas</h2>
                        <div class="nearby-grid" data-reveal-items>
                            {nearby.map((n) => {
                                const d = getDistance(station.lat, station.lng, n.lat, n.lng);
                                const nGeneric = /^n[ºo°]/i.test(n.brand) || /^\d/.test(n.brand);
                                return (
                                    <div class="nearby-card hover-lift">
                                        <a href={stationUrl(n)} class="nearby-name">{nGeneric ? n.address : n.brand}</a>
                                        <span class="nearby-addr">{displayCity(n.city)} · {d.toFixed(1)} km</span>
                                        <span class="nearby-prices">
                                            {n.prices.sp95 != null && <span>95: {fmt(n.prices.sp95)}</span>}
                                            {n.prices.diesel != null && <span>Diésel: {fmt(n.prices.diesel)}</span>}
                                        </span>
                                        <div class="nearby-compare"><CompareToggle stationId={n.id} variant="square" /></div>
                                    </div>
                                );
                            })}
                        </div>
                    </section>
                )
            }

            <section class="faq" data-reveal-items>
                <h2>Preguntas frecuentes</h2>
                {
                    faq.map((f) => (
                        <details class="faq-item">
                            <summary>{f.q}</summary>
                            <p>{f.a}</p>
                        </details>
                    ))
                }
            </section>
        </div>
    </div>

    <Footer />
</Layout>

<style>
    .page-container {
        padding: 5rem 2rem 3rem;
        min-height: 100vh;
        background-color: var(--bg);
        color: var(--text);
    }
    .content-wrapper {
        max-width: 1100px;
        margin: 0 auto;
    }
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .breadcrumb a {
        color: var(--text-muted);
        text-decoration: none;
    }
    .breadcrumb a:hover {
        color: var(--primary);
    }
    .breadcrumb .current {
        color: var(--text);
        font-weight: 600;
    }

    .station-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .logo-box {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        border-radius: 1rem;
        background: #fff;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .logo-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 4px;
    }
    .logo-box .material-symbols-outlined {
        font-size: 2.4rem;
        color: #64748b;
    }
    .head-text {
        flex: 1;
        min-width: 0;
    }
    h1 {
        font-family: var(--font-header);
        font-size: clamp(1.5rem, 3.5vw, 2.2rem);
        line-height: 1.1;
        margin-bottom: 0.5rem;
    }
    .address {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--text-muted);
        font-size: 0.95rem;
    }
    .address .material-symbols-outlined {
        font-size: 1.1rem;
    }
    .updated {
        color: var(--primary);
        font-weight: 600;
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }
    .head-actions {
        display: flex;
        gap: 0.6rem;
        flex-shrink: 0;
    }
    .route-btn {
        --pop-color: var(--secondary);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.75rem;
        background: var(--secondary);
        color: var(--on-secondary);
        font-weight: 700;
        text-decoration: none;
        flex-shrink: 0;
    }
    .route-btn:hover {
        filter: brightness(1.05);
    }

    /* Texto propio de la ficha (stationInsights). */
    .insights {
        margin: 0 0 2.5rem;
    }
    .insights h2 {
        margin-bottom: 1rem;
    }
    .insights p {
        max-width: 72ch;
        margin-bottom: 0.9rem;
        line-height: 1.7;
        color: var(--text-muted);
    }
    .insights a {
        color: var(--text);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--primary);
        text-underline-offset: 3px;
    }
    .insights a:hover {
        color: var(--primary);
    }
    .no-prices {
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid var(--secondary);
        color: var(--text);
        border-radius: 0.6rem;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }
    /* Precios de otro día: atenuados para que no parezcan los de hoy. */
    .price-card.stale {
        opacity: 0.6;
    }
    .restricted {
        background: rgba(251, 146, 60, 0.12);
        color: var(--accent);
        border-radius: 0.6rem;
        padding: 0.6rem 0.9rem;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    section h2 {
        font-family: var(--font-header);
        font-size: 1.3rem;
        margin-bottom: 1.25rem;
    }
    .prices-section {
        margin-bottom: 2rem;
    }
    .price-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 0.75rem;
    }
    .price-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.875rem;
        padding: 0.9rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        align-items: center;
    }
    .ptype {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
    }
    .pval {
        font-family: var(--font-header);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--primary);
