# Cadena de conexión a Postgres (Docker local por defecto).
DATABASE_URL=postgres://octogas:octogas@localhost:5432/octogas

# Puerto y dirección en los que escucha la API. Por defecto solo en local
# (127.0.0.1): en el VPS es Nginx quien la expone hacia fuera.
PORT=3001
# HOST=127.0.0.1

# Orígenes permitidos por CORS, separados por comas. Vacío = cualquiera (desarrollo).
# CORS_ORIGINS=https://octogas.es

# Dominios propios que se pueden acortar en /api/shorten (además de Google Maps).
# SITE_HOSTS=octogas.es,www.octogas.es,localhost,127.0.0.1

# Ruta al stations.json que genera la web (fuente de la ingesta).
# Por defecto: ../public/data/stations.json (relativo a /api).
# STATIONS_JSON=../public/data/stations.json
