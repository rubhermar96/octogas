# Cadena de conexión a Postgres (Docker local por defecto).
DATABASE_URL=postgres://octogas:octogas@localhost:5432/octogas

# Puerto del servidor de la API.
PORT=3001

# Ruta al stations.json que genera la web (fuente de la ingesta).
# Por defecto: ../public/data/stations.json (relativo a /api).
# STATIONS_JSON=../public/data/stations.json
