# Configuración del despliegue de OCTO en el VPS. Sin secretos: la contraseña de
# la base de datos la genera provision.sh y se guarda en /etc/octogas/database-url.

DOMAIN=octogas.es
REPO=https://github.com/rubhermar96/octogas.git
# Rama que se publica: la del diseño de ángulos rectos y alto contraste, que es la
# versión actual de la web (main se quedó en junio de 2026).
BRANCH=design-experiment-square-contrast

APP_USER=octo
APP_DIR=/srv/octogas
WEB_ROOT=/var/www/octogas
BACKUP_DIR=/var/backups/octogas

# Correo para los avisos de caducidad del certificado de Let's Encrypt.
CERTBOT_EMAIL=contactaocto@gmail.com
